@using SwipSwapMarketplace.Models

@code {
    [Parameter] public Product Product { get; set; } = new();
    [Parameter] public EventCallback<Product> OnViewDetails { get; set; }
}

<MudCard Elevation="6" 
        Class="ma-4 pa-4 product-card" 
        Style="background-color: var(--mud-palette-lighten); color: var(--mud-palette-text-primary); border-radius: 12px !important;"
        @onclick="() => OnViewDetails.InvokeAsync(Product)">

    <MudCardMedia Image="@Product.ImageUrl" Style="width:100%; height:200px"></MudCardMedia>
    <MudCardContent>
        <MudText>@Product.Name</MudText>
        <MudText>@Product.Description</MudText>
        <MudText>@Product.Price.ToString("C")</MudText>

    </MudCardContent>
</MudCard>

