@code {
    [Parameter] public EventCallback<string> OnSearch { get; set; }
    private string query = string.Empty;

    private async Task Search() => await OnSearch.InvokeAsync(query);
}

<MudTextField @bind-Value="query" Placeholder="Search products..." />
<MudButton OnClick="Search" Color="Color.Primary" Variant="Variant.Filled">Search</MudButton>
